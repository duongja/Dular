DATABASE_URL=postgres://dular:dular@127.0.0.1:5432/dular
SESSION_SECRET=replace-with-a-long-random-string
API_PORT=8787
PUBLIC_BASE_URL=https://api.dular.app
FIBER_RPC_URL=http://127.0.0.1:8227
FIBER_GATEWAY_RPC_TOKEN=
FIBER_OPERATOR_WS_ADDR=
FIBER_RECEIVER_RPC_URL=http://127.0.0.1:8247
FIBER_RECEIVER_CKB_ADDRESS=
CKB_TESTNET_RPC_URL=https://testnet.ckb.dev/

# Keep true for local development. Set false for production Daraja/Africa's Talking calls.
DEMO_MODE=true
# Set true when reviewers need OTP login without live Africa's Talking SMS.
OTP_DEMO_MODE=false

AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

MPESA_ENVIRONMENT=production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_B2C_SHORTCODE=
MPESA_INITIATOR_NAME=
MPESA_SECURITY_CREDENTIAL=
MPESA_TIMEOUT_URL=

# Browser self-custody M-Pesa ramp. Non-demo operation requires separate callback and operator tokens.
RAMP_DEPOSITS_ENABLED=false
RAMP_WITHDRAWALS_ENABLED=false
RAMP_MIN_KES=10
RAMP_MAX_KES=1000
RAMP_FEE_BPS=25
RAMP_QUOTE_EXPIRES_SECONDS=300
RAMP_CALLBACK_TOKEN=
RAMP_OPERATOR_TOKEN=
RAMP_FX_URL=https://open.er-api.com/v6/latest/USD
# Optional audited rate override, for example 129.50. Leave empty to use RAMP_FX_URL.
RAMP_USD_KES_RATE=
RAMP_CKB_SPONSOR_ENABLED=false
RAMP_CKB_SPONSOR_AMOUNT=200
RAMP_RECEIVE_ROUTES_ENABLED=true
RAMP_MAX_ROUTE_RUSD_BASE_UNITS=2000000000
RAMP_MAX_RESERVED_RUSD_BASE_UNITS=10000000000

# Old PostgreSQL-ledger wallet and money endpoints stay off by default.
LEGACY_MANAGED_WALLET_ENABLED=false
